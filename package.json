{
  "name": "powerpulse-api-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright API automation for PowerPulseRestAPI",
  "scripts": {
    "test:api": "node scripts/run-and-report.js",
    "test:api:headed": "playwright test --headed",
    "coverage:report": "node scripts/generate-coverage-report.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^2.15.1",
    "dotenv": "^16.4.5"
  }
}
