{
  "name": "powerpulse-api-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright API automation for PowerPulseRestAPI",
  "scripts": {
    "test": "npm run test:api",
    "test:api": "node scripts/run-and-report.js",
    "test:api:headed": "playwright test --headed",
    "coverage:report": "node scripts/generate-coverage-report.js",
    "allure:generate": "node scripts/generate-allure-report.js",
    "report": "npm run report:offline",
    "report:offline": "node scripts/generate-allure-report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^2.15.1",
    "dotenv": "^16.4.5"
  }
}
