# Base URL of the PowerPulseRestAPI (no trailing slash)
BASE_URL=https://ubti-t-powerpulse-api.azurewebsites.net

# API path version segment used to replace {version} in OpenAPI paths
API_VERSION=1

# JWT bearer token (without the "Bearer " prefix). All 153 operations execute regardless;
# without a real token, authenticated-only endpoints execute and fail with the exact reason.
AUTH_TOKEN=

# Optional tenant id used by payload builders where the API requires one. No real tenant is known from the spec.
TEST_TENANT_ID=1

# Max acceptable response time in milliseconds for response-time assertions
RESPONSE_TIME_THRESHOLD_MS=5000
